---
// LegalMove MVP — vista única. Sin frameworks de UI: solo Astro + Tailwind + JS vanilla.
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LegalMove — Comparador de Contratos</title>
  </head>
  <body class="min-h-screen bg-slate-100 text-slate-900">
    <main class="mx-auto max-w-2xl px-4 py-10">
      <h1 class="mb-2 text-3xl font-bold">LegalMove</h1>
      <p class="mb-8 text-slate-600">Compara tu contrato original con su enmienda y obtén un reporte de cambios.</p>

      <div class="rounded-lg bg-white p-6 shadow">
        <!-- Estado 1: Formulario -->
        <section id="ui-form">
          <form id="compare-form">
            <div class="mb-4">
              <label for="file-original" class="mb-1 block font-medium">Contrato Original</label>
              <input
                type="file"
                id="file-original"
                accept=".jpg,.jpeg,.png,.pdf"
                required
                class="block w-full rounded border border-slate-300 p-2"
              />
            </div>
            <div class="mb-6">
              <label for="file-amendment" class="mb-1 block font-medium">Enmienda</label>
              <input
                type="file"
                id="file-amendment"
                accept=".jpg,.jpeg,.png,.pdf"
                required
                class="block w-full rounded border border-slate-300 p-2"
              />
            </div>
            <button
              type="submit"
              class="w-full rounded bg-blue-600 px-4 py-2 font-semibold text-white hover:bg-blue-700"
            >
              Analizar Documentos
            </button>
          </form>
        </section>

        <!-- Estado 2: Carga -->
        <section id="ui-loading" class="hidden text-center">
          <div
            class="mx-auto mb-4 h-10 w-10 animate-spin rounded-full border-4 border-slate-300 border-t-blue-600"
            role="status"
            aria-label="Cargando"
          ></div>
          <p>Procesando documentos con IA...</p>
        </section>

        <!-- Estado 3: Resultados -->
        <section id="ui-results" class="hidden">
          <h2 class="mb-4 text-xl font-bold">Reporte de cambios</h2>

          <h3 class="mb-1 font-semibold">Resumen</h3>
          <p id="res-summary" class="mb-4"></p>

          <h3 class="mb-1 font-semibold">Secciones modificadas</h3>
          <ul id="res-sections" class="mb-4 list-disc pl-5"></ul>

          <h3 class="mb-1 font-semibold">Temas afectados</h3>
          <ul id="res-topics" class="mb-6 flex flex-wrap gap-2"></ul>

          <button
            type="button"
            id="btn-reset"
            class="w-full rounded bg-slate-600 px-4 py-2 font-semibold text-white hover:bg-slate-700"
          >
            Nueva comparación
          </button>
        </section>
      </div>
    </main>

    <script>
      const form = document.getElementById('compare-form');
      const uiForm = document.getElementById('ui-form');
      const uiLoading = document.getElementById('ui-loading');
      const uiResults = document.getElementById('ui-results');
      const fileOriginal = document.getElementById('file-original');
      const fileAmendment = document.getElementById('file-amendment');
      const resSummary = document.getElementById('res-summary');
      const resSections = document.getElementById('res-sections');
      const resTopics = document.getElementById('res-topics');
      const btnReset = document.getElementById('btn-reset');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        uiForm.classList.add('hidden');
        uiResults.classList.add('hidden');
        uiLoading.classList.remove('hidden');

        const formData = new FormData();
        formData.append('original_image', fileOriginal.files[0]);
        formData.append('amendment_image', fileAmendment.files[0]);

        try {
          const response = await fetch('http://localhost:8000/api/compare', {
            method: 'POST',
            body: formData,
          });
          if (!response.ok) {
            throw new Error('Request failed with status ' + response.status);
          }
          const data = await response.json();

          resSummary.textContent = data.summary_of_the_change;
          resSections.innerHTML = '';
          (data.sections_changed || []).forEach((section) => {
            const li = document.createElement('li');
            li.textContent = section;
            resSections.appendChild(li);
          });
          resTopics.innerHTML = '';
          (data.topics_touched || []).forEach((topic) => {
            const li = document.createElement('li');
            li.textContent = topic;
            li.className =
              'rounded-full bg-blue-100 px-3 py-1 text-sm font-medium text-blue-800';
            resTopics.appendChild(li);
          });

          uiLoading.classList.add('hidden');
          uiResults.classList.remove('hidden');
        } catch (err) {
          uiLoading.classList.add('hidden');
          uiForm.classList.remove('hidden');
          alert('Ocurrió un error al procesar los documentos. Inténtalo de nuevo.');
        }
      });

      btnReset.addEventListener('click', () => {
        uiResults.classList.add('hidden');
        uiForm.classList.remove('hidden');
        form.reset();
      });
    </script>
  </body>
</html>
